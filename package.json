{
  "name": "roblox-cinema",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "playwright test tests/browser/extension.spec.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "preview": "vite --host 127.0.0.1 --open /preview.html",
    "test:preview": "playwright test tests/browser/preview.spec.ts"
  },
  "dependencies": {
    "liquid-glass-react": "^1.1.1",
    "lucide": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/chrome": "^0.1.35",
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
